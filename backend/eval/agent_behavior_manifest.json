    {
      "scenario_class": "tool_failure_degradation",
      "title": "工具失败降级",
      "query": "Please compare my latest report with the prior report.",
      "user": {
        "username": "eval_tool_failure",
        "email": "eval_tool_failure@example.com",
        "profile": {
          "Age": 49,
          "Gender": 1,
          "BMI": 26.9,
          "Glucose_Fasting": 6.9,
          "risk_history": "{\"comparison\": {\"risk_level\": \"medium\"}}"
        }
      },
      "rag": null,
      "tool_outputs": {
        "report_summary_lookup": {
          "status": "blocked",
          "reason": "tool_unavailable",
          "tool": "report_summary_lookup"
        },
        "report_comparison_lookup": {
          "status": "blocked",
          "reason": "tool_unavailable",
          "tool": "report_comparison_lookup"
        }
      },
      "expected": {
        "lane": "report_interpretation",
        "verdict": "insufficient_evidence",
        "policy_answer_mode": "clarify_missing_context",
        "policy_degrade_reason": "tool_unavailable",
        "response_mode": "clarify_missing_context",
        "response_degraded_reason": "tool_unavailable",
        "evidence_sufficiency": "insufficient",
        "human_escalation_required": true
      }
    }
  ]
}
