# ===========================================
# Health AI Platform 2.0 - Git Ignore Rules
# ===========================================

# ==========================
# 1. 敏感信息
# ==========================
.env
.env.*
.env.local
.env.production
*.key
*.pem
*.crt
secrets/
credentials/

# API Keys and Tokens
*_secret*
*_token*
*.secret

# ==========================
# 2. Python 环境与依赖
# ==========================
venv/
.venv/
env/
ENV/
.python-version

__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

pip-log.txt
pip-delete-this-directory.txt

# ==========================
# 3. 前端构建与 Node 依赖
# ==========================
frontend/node_modules/
frontend/dist/
frontend/.output/
frontend/.nuxt/
frontend/.tmp/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================
# 4. 数据仓库与本地上传资产
# ==========================
# 原始数据和处理后的数据通常体积较大，按资产清单管理，不进入普通代码提交。
data_warehouse/raw_data/
data_warehouse/raw/
data_warehouse/processed_data/
data_warehouse/processed/

# 向量库和本地上传目录属于运行时资产。
backend/rag/vector_store/
backend/rag/chroma_db/
*.index
*.faiss

temp_uploads/
backend/temp_uploads/
uploads/
backend/uploads/

# ==========================
# 5. 模型文件
# ==========================
*.pkl
*.pickle
*.pth
*.pt
*.bin
*.h5
*.hdf5
*.onnx
*.safetensors

models/
ai_core/models/
backend/data/models/
~/.paddleocr/

# ==========================
# 6. 数据库文件
# ==========================
*.db
*.sqlite
*.sqlite3
health_ai.db

# ==========================
# 7. 日志、缓存与临时产物
# ==========================
*.log
logs/
*.cache
.cache/
*.tmp
*.temp
.tmp/
tmp_doc_extract/
output/

.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

.ipynb_checkpoints/

# ==========================
# 8. IDE 与编辑器配置
# ==========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==========================
# 9. 系统文件
# ==========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ==========================
# 10. 项目特定产物
# ==========================
.gemini/

# 生成型 PDF 默认不提交；论文封面声明保留为例外。
*.pdf
!thesis_latex/frontmatter/cover_declaration.pdf

*.bak
*.backup

test_output/
